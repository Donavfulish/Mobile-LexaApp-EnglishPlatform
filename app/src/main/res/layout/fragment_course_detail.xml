<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:shimmer_auto_start="true">
        <include layout="@layout/layout_course_detail_skeleton" />
    </com.facebook.shimmer.ShimmerFrameLayout>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- DÁN TOÀN BỘ NỘI DUNG CŨ CỦA BẠN VÀO ĐÂY -->
            <!-- Background Image -->
            <ImageView
                android:id="@+id/backgroundCourse"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/background_course"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Topic Button -->
            <com.home.lexa.ui.components.PrimaryButton
                android:id="@+id/topic"
                android:layout_width="132dp"
                android:layout_height="22dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="113dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Title Course -->
            <TextView
                android:id="@+id/titleCourse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="143dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/archivo_bold"
                android:lineHeight="30dp"
                android:text="Làm Chủ Tiếng Anh Công Sở Trong 30 Ngày"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- ==================== KHU VỰC THÔNG TIN (TEACHER) ==================== -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgTeacher"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="70dp"
                android:layout_marginTop="24dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/backgroundCourse"
                app:shapeAppearanceOverlay="@style/RoundedCorner"
                android:src="@drawable/placeholder_teacher" />

            <TextView
                android:id="@+id/teacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/archivo_regular"
                android:text="GIÁO VIÊN"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@+id/imgTeacher"
                app:layout_constraintStart_toStartOf="@+id/imgTeacher"
                app:layout_constraintTop_toBottomOf="@+id/imgTeacher" />

            <TextView
                android:id="@+id/teacherNameCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/archivo_bold"
                android:text="John Smith"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/imgTeacher"
                app:layout_constraintStart_toStartOf="@+id/imgTeacher"
                app:layout_constraintTop_toBottomOf="@+id/teacher" />


            <!-- ==================== ĐƯỜNG KẺ DỌC ==================== -->
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/verticalDivider"
                android:layout_width="1dp"
                android:layout_height="80dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="24dp"
                app:dividerColor="@color/gray_E0E0E5"
                app:layout_constraintStart_toEndOf="@+id/teacherNameCourse"
                app:layout_constraintTop_toBottomOf="@+id/backgroundCourse" />


            <!-- ==================== KHU VỰC THÔNG TIN (STUDENT) ==================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/circleStudent"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="50dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/purple_100"
                android:gravity="center"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="100dp"
                app:icon="@drawable/ic_group"
                app:iconTint="@color/purple_paragraph"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:layout_constraintStart_toEndOf="@+id/verticalDivider"
                app:layout_constraintTop_toBottomOf="@+id/backgroundCourse" />

            <TextView
                android:id="@+id/student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/archivo_regular"
                android:text="HỌC VIÊN"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@+id/circleStudent"
                app:layout_constraintStart_toStartOf="@+id/circleStudent"
                app:layout_constraintTop_toBottomOf="@+id/circleStudent" />

            <TextView
                android:id="@+id/studentNumCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/archivo_bold"
                android:text="1,245"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/circleStudent"
                app:layout_constraintStart_toStartOf="@+id/circleStudent"
                app:layout_constraintTop_toBottomOf="@+id/student" />


            <!-- ==================== KHU VỰC THÔNG TIN (FAVORITE) ==================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/circleFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="65dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/purple_100"
                android:gravity="center"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="100dp"
                app:icon="@drawable/ic_favorite_border_btn"
                app:iconTint="@color/purple_paragraph"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:layout_constraintStart_toEndOf="@+id/circleStudent"
                app:layout_constraintTop_toBottomOf="@+id/backgroundCourse" />

            <TextView
                android:id="@+id/favorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/archivo_regular"
                android:text="YÊU THÍCH"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@+id/circleFavorite"
                app:layout_constraintStart_toStartOf="@+id/circleFavorite"
                app:layout_constraintTop_toBottomOf="@+id/circleFavorite" />

            <TextView
                android:id="@+id/favoriteNumCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/archivo_bold"
                android:gravity="center"
                android:text="850"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/circleFavorite"
                app:layout_constraintStart_toStartOf="@+id/circleFavorite"
                app:layout_constraintTop_toBottomOf="@+id/favorite" />


            <!-- ==================== ĐƯỜNG KẺ NGANG BÊN DƯỚI CÙNG ==================== -->
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/horizontalDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:dividerColor="@color/gray_E0E0E5"
                app:layout_constraintTop_toBottomOf="@+id/teacherNameCourse" />

            <TextView
                android:id="@+id/introductionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28dp"
                android:textStyle="bold"
                android:text="Giới thiệu khoá học"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/archivo_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalDivider"/>

            <TextView
                android:id="@+id/introduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14dp"
                android:lineHeight="23dp"
                android:text="Khóa học tập trung vào các tình huống giao tiếp thực tế nhất trong môi trường văn phòng chuyên nghiệp. Bạn sẽ được rèn luyện phát âm chuẩn AI và xây dựng vốn từ vựng chuyên ngành vững chắc."
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/archivo_regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/introductionTitle"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/gray_E0E0E5"
                app:strokeWidth="0dp"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/introduction">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp">
                    <com.home.lexa.ui.components.IconButton
                        android:id="@+id/speakingBtn"
                        android:layout_width="175dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.home.lexa.ui.components.IconButton
                        android:id="@+id/vocabularyBtn"
                        android:layout_width="175dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/speakingBtn"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

<!--            Speaking-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/speakingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/cardLayout"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >
                <ImageView
                    android:id="@+id/icon_play"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_play_circle"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:id="@+id/routeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="Lộ trình"
                    android:fontFamily="@font/archivo_bold"
                    android:textSize="16dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintStart_toEndOf="@+id/icon_play"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <TextView
                    android:id="@+id/speakingNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="15 Bài học"
                    android:textColor="@color/purple_paragraph"
                    android:fontFamily="@font/archivo_bold"
                    android:textSize="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                <LinearLayout
                    android:id="@+id/speakingDayLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@+id/icon_play"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.home.lexa.ui.components.PrimaryButton
                    android:id="@+id/learningBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/speakingDayLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

<!--            Vocabulary-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vocabularyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/cardLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.home.lexa.ui.components.SearchbarFilter
                    android:id="@+id/search_bar_vocabulary"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/titleFlashcard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:text="Danh sách Flashcards"
                    android:textStyle="bold"
                    android:textSize="18dp"
                    android:fontFamily="@font/archivo_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/search_bar_vocabulary"
                    />

                <TextView
                    android:id="@+id/flashcardNum"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_gray_rounded"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/titleFlashcard"
                    app:layout_constraintStart_toEndOf="@id/titleFlashcard"
                    app:layout_constraintTop_toTopOf="@id/titleFlashcard" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/vocabularyListLayout"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:fillViewport="true"
                    android:layout_marginTop="20dp"
                    app:layout_constraintVertical_bias="0.0"
                    app:layout_constraintTop_toBottomOf="@id/titleFlashcard"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.gridlayout.widget.GridLayout
                        android:id="@+id/vocabularyGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:padding="8dp"
                        app:columnCount="2"
                        app:alignmentMode="alignMargins"/>

                </androidx.core.widget.NestedScrollView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/rememberCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gray_E0E0E5"
                    app:cardBackgroundColor="@color/gray_F4F4F6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vocabularyListLayout">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/icon_remember"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="15dp"
                            android:background="@drawable/bg_white_circle"
                            android:padding="6dp"
                            android:src="@drawable/ic_priority"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/text_remember"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/archivo_bold"
                            android:text="Mẹo học nhanh"
                            android:textColor="@color/black"
                            android:textSize="14dp"
                            android:textStyle="bold"
                            android:layout_marginStart="25dp"
                            app:layout_constraintStart_toEndOf="@+id/icon_remember"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Chạm vào thẻ để xem nghĩa và ví dụ. Đừng quên bật âm thanh để nghe cách phát âm chuẩn nhé!"
                            android:textSize="13dp"
                            android:fontFamily="@font/archivo_regular"
                            android:layout_marginTop="5dp"
                            android:layout_marginStart="25dp"
                            android:lineHeight="18dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/icon_remember"
                            app:layout_constraintTop_toBottomOf="@+id/text_remember"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.home.lexa.ui.components.CircleButton
                    android:id="@+id/vocabularyIconBtn"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rememberCard"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>