<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- DÁN TOÀN BỘ NỘI DUNG CŨ CỦA BẠN VÀO ĐÂY -->
            <!-- Background Image -->
            <ImageView
                android:id="@+id/backgroundCourse"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/background_course"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <com.home.lexa.ui.components.CircleButton
                android:id="@+id/cameraBtn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="10dp"/>


            <!-- ==================== KHU VỰC THÔNG TIN (TEACHER) ==================== -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgTeacher"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="70dp"
                android:layout_marginTop="24dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/backgroundCourse"
                app:shapeAppearanceOverlay="@style/RoundedCorner"
                android:src="@drawable/placeholder_teacher" />

            <TextView
                android:id="@+id/teacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/archivo_regular"
                android:text="GIÁO VIÊN"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@+id/imgTeacher"
                app:layout_constraintStart_toStartOf="@+id/imgTeacher"
                app:layout_constraintTop_toBottomOf="@+id/imgTeacher" />

            <TextView
                android:id="@+id/teacherNameCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/archivo_bold"
                android:text="John Smith"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/imgTeacher"
                app:layout_constraintStart_toStartOf="@+id/imgTeacher"
                app:layout_constraintTop_toBottomOf="@+id/teacher" />


            <!-- ==================== ĐƯỜNG KẺ DỌC ==================== -->
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/verticalDivider"
                android:layout_width="1dp"
                android:layout_height="80dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="24dp"
                app:dividerColor="@color/gray_E0E0E5"
                app:layout_constraintStart_toEndOf="@+id/teacherNameCourse"
                app:layout_constraintTop_toBottomOf="@+id/backgroundCourse" />


            <!-- ==================== KHU VỰC THÔNG TIN (STUDENT) ==================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/circleStudent"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="50dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/purple_100"
                android:gravity="center"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="100dp"
                app:icon="@drawable/ic_group"
                app:iconTint="@color/purple_paragraph"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:layout_constraintStart_toEndOf="@+id/verticalDivider"
                app:layout_constraintTop_toBottomOf="@+id/backgroundCourse" />

            <TextView
                android:id="@+id/student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/archivo_regular"
                android:text="HỌC VIÊN"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@+id/circleStudent"
                app:layout_constraintStart_toStartOf="@+id/circleStudent"
                app:layout_constraintTop_toBottomOf="@+id/circleStudent" />

            <TextView
                android:id="@+id/studentNumCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/archivo_bold"
                android:text="0"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/circleStudent"
                app:layout_constraintStart_toStartOf="@+id/circleStudent"
                app:layout_constraintTop_toBottomOf="@+id/student" />


            <!-- ==================== KHU VỰC THÔNG TIN (FAVORITE) ==================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/circleFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="65dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/purple_100"
                android:gravity="center"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="100dp"
                app:icon="@drawable/ic_favorite_border_btn"
                app:iconTint="@color/purple_paragraph"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:layout_constraintStart_toEndOf="@+id/circleStudent"
                app:layout_constraintTop_toBottomOf="@+id/backgroundCourse" />

            <TextView
                android:id="@+id/favorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/archivo_regular"
                android:text="YÊU THÍCH"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@+id/circleFavorite"
                app:layout_constraintStart_toStartOf="@+id/circleFavorite"
                app:layout_constraintTop_toBottomOf="@+id/circleFavorite" />

            <TextView
                android:id="@+id/favoriteNumCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/archivo_bold"
                android:gravity="center"
                android:text="0"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/circleFavorite"
                app:layout_constraintStart_toStartOf="@+id/circleFavorite"
                app:layout_constraintTop_toBottomOf="@+id/favorite" />


            <!-- ==================== ĐƯỜNG KẺ NGANG BÊN DƯỚI CÙNG ==================== -->
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/horizontalDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:dividerColor="@color/gray_E0E0E5"
                app:layout_constraintTop_toBottomOf="@+id/teacherNameCourse" />
            <TextView
                android:id="@+id/courseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:textStyle="bold"
                android:text="Tên khoá học"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/archivo_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalDivider"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/courseTitleInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/courseTitle"
                app:boxStrokeColor="@color/gray"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/courseTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập tên khóa học"
                    android:fontFamily="@font/archivo_regular"
                    android:inputType="text"
                    android:padding="12dp"
                    android:maxLength="200" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/topicTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:textStyle="bold"
                android:text="Loại khoá học"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/archivo_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/courseTitleInputLayout"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/topicInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="150dp"
                android:layout_marginStart="16dp"

                app:hintEnabled="false"
                app:boxStrokeColor="@color/gray_E0E0E5"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:layout_constraintTop_toBottomOf="@id/topicTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <AutoCompleteTextView
                    android:id="@+id/topicInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:padding="12dp"
                    android:hint="Chọn loại khoá học"
                    android:fontFamily="@font/archivo_regular"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:id="@+id/introductionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:textStyle="bold"
                android:text="Mô tả khoá học"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/archivo_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/topicInputLayout"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/introductionInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toBottomOf="@id/introductionTitle"
                app:boxStrokeColor="@color/gray"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/introductionInput"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="top"
                    android:hint="Nhập mô tả khoá học"
                    android:fontFamily="@font/archivo_regular"

                    android:inputType="textMultiLine"
                    android:imeOptions="actionDone"

                    android:singleLine="false"
                    android:padding="12dp"
                    android:textSize="14dp"
                    android:lineHeight="23dp"
                    android:maxLength="2000"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.home.lexa.ui.components.PrimaryButton
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp"
                app:layout_constraintTop_toBottomOf="@+id/introductionInputLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/gray_E0E0E5"
                app:strokeWidth="0dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/saveBtn">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp">
                    <com.home.lexa.ui.components.IconButton
                        android:id="@+id/speakingBtn"
                        android:layout_width="175dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.home.lexa.ui.components.IconButton
                        android:id="@+id/vocabularyBtn"
                        android:layout_width="175dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/speakingBtn"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--            Speaking-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/speakingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/cardLayout"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >
                <ImageView
                    android:id="@+id/icon_play"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_play_circle"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:id="@+id/routeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="Lộ trình"
                    android:fontFamily="@font/archivo_bold"
                    android:textSize="16dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintStart_toEndOf="@+id/icon_play"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <TextView
                    android:id="@+id/speakingNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="15 Bài học"
                    android:textColor="@color/purple_paragraph"
                    android:fontFamily="@font/archivo_bold"
                    android:textSize="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                <LinearLayout
                    android:id="@+id/speakingDayLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@+id/icon_play"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--          ========================  Vocabulary =========================-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vocabularyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/cardLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.home.lexa.ui.components.SearchbarFilter
                    android:id="@+id/search_bar_vocabulary"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/titleFlashcard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:text="Danh sách Flashcards"
                    android:textStyle="bold"
                    android:textSize="18dp"
                    android:fontFamily="@font/archivo_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/search_bar_vocabulary"
                    />

                <TextView
                    android:id="@+id/flashcardNum"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_gray_rounded"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/titleFlashcard"
                    app:layout_constraintStart_toEndOf="@id/titleFlashcard"
                    app:layout_constraintTop_toTopOf="@id/titleFlashcard" />

                <TextView
                    android:id="@+id/titleToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chỉnh sửa"
                    android:textStyle="bold"
                    android:fontFamily="@font/archivo_bold"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="@id/editToggle"
                    app:layout_constraintTop_toTopOf="@id/editToggle"
                    app:layout_constraintEnd_toStartOf="@id/editToggle"/>

                <com.home.lexa.ui.components.ToggleSwitch
                    android:id="@+id/editToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/search_bar_vocabulary"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.gridlayout.widget.GridLayout
                        android:id="@+id/vocabularyGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:layout_constraintVertical_bias="0.0"
                        app:layout_constraintTop_toBottomOf="@id/titleFlashcard"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:padding="8dp"
                        app:columnCount="2"
                        app:alignmentMode="alignMargins"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.home.lexa.ui.components.CircleButton
        android:id="@+id/addBtn"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>